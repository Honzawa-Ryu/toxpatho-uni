#!/bin/bash
# 凍結エンコーダで TG-GATEs 全スライドの特徴を抽出する。
#
#   qsub -v ENCODER=uni    scripts/extract_features.pbs
#   qsub -v ENCODER=uni2h  scripts/extract_features.pbs
#   qsub -v ENCODER=vit_imagenet scripts/extract_features.pbs
#
# 本プロジェクト外で学習した DINO(ViT-B/16) を評価する場合は、チェックポイントと
# 出力名を渡す。同じ学習ランの別 epoch を並べられるように NAME で分けること。
#   SSL=/work/gd43/d43000/toxpatho-ssl-comparison/outputs/0026_20260901_dino_clipgrad03
#   qsub -v ENCODER=dino,DINO_CKPT=$SSL/model_ep85.pt,NAME=dino_ep85 scripts/extract_features.pbs
#   qsub -v ENCODER=dino,DINO_CKPT=$SSL/model_ep45.pt,NAME=dino_ep45 scripts/extract_features.pbs
# DINO は ViT-B/16 で UNI(ViT-L/16) より軽いので、所要は UNI の 35 分より短いはず。
#
# スモークテスト（数十スライドだけ、debug-g で数分）。
# **必ず OUT_DIR を分けること。** h5 は slide_id の並びを保存するので、間引いた
# 状態のファイルが残っていると本番実行が整合性チェックで落ちる。
#   qsub -q debug-g -l walltime=00:20:00 \
#        -v ENCODER=uni,LIMIT=20,OUT_DIR=outputs/features_smoke scripts/extract_features.pbs
#
# 実測(Phase 0): UNI ~3,000 img/s → 全 11,177 スライドで約 35 分、
#                UNI2-h ~1,200 img/s → 約 85 分。walltime は余裕を見て 3 時間。
# 中断しても done フラグから再開できるので、投げ直すだけでよい。
#
# Miyabi-G のキュー（qstat --rsc -x で確認）:
#   debug-g   1-16 node / 最大 00:30:00
#   short-g   1- 8 node / 最大 08:00:00   ← 本番はこれで足りる
#   small-g   1-16 node / 最大 48:00:00   ※ regular-g は親で直接投げられない
#
# VRAM 見積もり（重みは fp32 のまま autocast bf16 で走らせた場合の概算）:
#   sub_batch |   UNI  | UNI2-h
#        64   | ~2.8G  | ~5.4G
#       128   | ~3.0G  | ~6.1G
#       256   | ~3.5G  | ~7.6G   ← 既定
#       512   | ~4.6G  | ~10.7G
# 16 GB の GPU なら既定のままで両モデルとも通る。12 GB 以下なら SUB_BATCH=64、
# それでも足りなければ extract_features.py の model.cuda() を .to(torch.bfloat16)
# にすると重み分（UNI 0.6G / UNI2-h 1.4G）が浮く。実測値はログの "VRAM peak" 行。
#
#PBS -N extract_feat
#PBS -q short-g
#PBS -W group_list=gd43
#PBS -l select=1
#PBS -l walltime=03:00:00
#PBS -o logs/
#PBS -j oe
#PBS -V

set -eux
cd "${PBS_O_WORKDIR:-$PWD}"
mkdir -p logs outputs/features

: "${ENCODER:?ENCODER を -v で渡すこと (uni | uni2h | vit_imagenet | dino)}"
if [ "$ENCODER" = "dino" ]; then
  : "${DINO_CKPT:?ENCODER=dino には DINO_CKPT を -v で渡すこと}"
  : "${NAME:?ENCODER=dino には NAME を -v で渡すこと (例 dino_ep85)}"
fi

# HF_TOKEN は ~/.bashrc に置いてある。.env があればそちらも読む。
# /etc/bashrc が未定義変数を参照するため、読み込む間だけ set -u を外す。
set +u
[ -f "$HOME/.bashrc" ] && . "$HOME/.bashrc" || true
[ -f .env ] && set -a && . ./.env && set +a || true
set -u
# DINO は手元のチェックポイントを読むだけなので HF は要らない。
case "$ENCODER" in
  uni|uni2h) : "${HF_TOKEN:?HF_TOKEN が取れていない。~/.bashrc の export を確認すること}" ;;
esac

echo "host=$(hostname) date=$(date) encoder=$ENCODER"
nvidia-smi || true

.venv/bin/python -u scripts/extract_features.py \
  --encoder "$ENCODER" \
  ${DINO_CKPT:+--dino-ckpt "$DINO_CKPT"} \
  ${NAME:+--name "$NAME"} \
  ${LIMIT:+--limit "$LIMIT"} \
  --workers "${WORKERS:-8}" \
  --sub-batch "${SUB_BATCH:-256}" \
  --out-dir "${OUT_DIR:-outputs/features}"
